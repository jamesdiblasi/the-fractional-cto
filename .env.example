# The Fractional CTO. Copy to .env.local for development. In production these
# are App Service application settings.
#
# Everything except NEXT_PUBLIC_* is read at request time, so a change in App
# Service settings takes effect on restart without a rebuild. NEXT_PUBLIC_*
# values are compiled into the client bundle and need a rebuild.

# --- Identity ---------------------------------------------------------------
SITE_NAME="The Fractional CTO"
SITE_URL=https://thefractionalcto.com.au
# One sentence. Used for the meta description and the JSON-LD.
# SITE_TAGLINE=

# Where every "Book a discovery call" button goes. Microsoft Bookings, Calendly,
# Cal.com, any URL. Until it is set, buttons scroll to the contact section.
# BOOKING_URL=https://outlook.office365.com/book/...

# Shown in the footer and contact section, and the default destination for
# form enquiries.
CONTACT_EMAIL=hello@thefractionalcto.com.au
# Where enquiries and download notifications are delivered. Defaults to
# CONTACT_EMAIL.
# CONTACT_TO_EMAIL=

CURRENCY=AUD

# --- Pricing switches -------------------------------------------------------
# Each tier has three settings. Leave unset for the defaults shown.
#   *_ENABLED     show the tier at all          (default true)
#   *_SHOW_PRICE  print the monthly price       (default true)
#   *_PRICE          whole dollars per month
#   *_COMPARE_PRICE  optional struck-through price beside the real one, 0 = none
#   *_NAME           override the tier name
TIER_ADVISOR_ENABLED=true
TIER_ADVISOR_SHOW_PRICE=true
TIER_ADVISOR_PRICE=2500

TIER_FRACTIONAL_ENABLED=true
TIER_FRACTIONAL_SHOW_PRICE=true
TIER_FRACTIONAL_PRICE=6000
# TIER_FRACTIONAL_COMPARE_PRICE=7500

TIER_EMBEDDED_ENABLED=true
TIER_EMBEDDED_SHOW_PRICE=true
TIER_EMBEDDED_PRICE=12000

# Fixed-scope work. Prices are "from" prices.
ONEOFF_AUDIT_ENABLED=true
ONEOFF_AUDIT_SHOW_PRICE=true
ONEOFF_AUDIT_PRICE=4500

ONEOFF_MVP_ENABLED=true
ONEOFF_MVP_SHOW_PRICE=true
ONEOFF_MVP_PRICE=25000

# --- Sections ---------------------------------------------------------------
LEAD_MAGNET_ENABLED=true
CONTACT_FORM_ENABLED=true

# --- Email (Mailjet) --------------------------------------------------------
# Both forms send through Mailjet's Send API v3.1. The sender address must be a
# validated sender or domain in the Mailjet account. Without these the contact
# form returns a friendly error pointing at CONTACT_EMAIL, and the checklist
# form still hands over the PDF link, just without the email.
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
# MAILJET_FROM_EMAIL=hello@thefractionalcto.com.au
# MAILJET_FROM_NAME="The Fractional CTO"

# --- Analytics (build-time) -------------------------------------------------
# Either or both. Nothing loads when unset.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=thefractionalcto.com.au
